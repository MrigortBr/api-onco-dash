# ── Servidor ──────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Quantos proxies confiáveis ficam na frente da API (Railway + repasse do Next = 2).
TRUST_PROXY=1

# ── Banco (PostgreSQL) ────────────────────────────────────────────────────
# DATABASE_URL tem prioridade (Railway). Sem ela, usa as variáveis DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=oncodash
DB_SSL=false
DB_LOGGING=false

# ── Login ─────────────────────────────────────────────────────────────────
# Obrigatória. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Cookie da sessão. Em produção (HTTPS) deixe COOKIE_SECURE=true.
COOKIE_NAME=oncodash_session
COOKIE_SECURE=false
# Distância (km) a partir da qual um login é marcado como suspeito.
LOGIN_DISTANCIA_SUSPEITA_KM=300

# ── CPF ───────────────────────────────────────────────────────────────────
# Obrigatória para ativar contas. 32 bytes em hex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CPF_ENCRYPTION_KEY=

# ── Front e CORS ──────────────────────────────────────────────────────────
# Endereço do front (usado nos links de convite e de senha).
FRONTEND_URL=http://localhost:3000
# Origens liberadas, separadas por vírgula. Em produção é obrigatória.
CORS_ORIGIN=http://localhost:3000

# ── E-mail (mesmo serviço do SIMDASH) ─────────────────────────────────────
MAIL_API_URL=
MAIL_API_SECRET=
# Nome do remetente (opcional; padrão: "OncoDash — Autorização Prévia de Medicamentos Oncológicos")
MAIL_FROM_NAME=

# ── Usuários da tb_usuario (npm run seed:usuarios) ────────────────────────
# Caminho do CSV exportado da tb_usuario (padrão: dados/tb_usuario.csv).
SEED_USUARIOS_CSV=

# ── Atualização com o banco do APAC Onco (igual ao SIMDASH) ───────────────
# Conexão SOMENTE LEITURA com o banco do APAC Onco. A API copia as tabelas
# do painel (schema dbapaconco) para o schema `apac` deste banco todo dia às
# 9h, 13h e 17h (Brasília) e quando um Desenvolvedor/Gestor federal clica em
# "Atualizar agora". Sem estas variáveis, nada é atualizado.
SOURCE_DB_HOST=
SOURCE_DB_PORT=5432
SOURCE_DB_USER=
SOURCE_DB_PASS=
SOURCE_DB_NAME=
SOURCE_DB_SCHEMA=dbapaconco
SOURCE_DB_SSL=false

# Horário extra (opcional), além de 9h/13h/17h — Brasília. "21" ou "9:30".
SYNC_EXTRA_HOUR=

# Chave do código do paciente (HMAC do CPF/CNS, para contar pacientes sem
# guardar quem é). Opcional: sem ela usa a CPF_ENCRYPTION_KEY. Trocar a chave
# muda todos os códigos.
PACIENTE_HASH_KEY=
